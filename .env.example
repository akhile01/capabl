# Environment variables for AdaptEd project

# ---- LLM provider -------------------------------------------------------
# Option A (default when set): Nova API — any OpenAI-compatible gateway.
NOVA_API_KEY=your_nova_api_key_here
# Base URL of the gateway's OpenAI-compatible endpoint (check your Nova dashboard).
NOVA_BASE_URL=https://api.novaapi.ai/v1
# Leave empty to auto-pick the strongest chat model the gateway lists
# (run `python list_models.py` to see what is available), or pin one, e.g. claude-opus-4-1
NOVA_MODEL=
# Optional: comma-separated substrings, best first, used for auto-selection.
# NOVA_MODEL_PREFERENCES=claude-opus,gpt-5,gemini-2.5-pro

# Option B: Google Gemini directly.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: Amazon Nova / AWS Bedrock / Deepgram
AMAZON_NOVA_API_KEY=your_nova_api_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Force a provider instead of auto-detecting from the keys above: nova | gemini
# LLM_PROVIDER=nova

# ---- Server ---------------------------------------------------------------
DATABASE_URL=sqlite:///database.db
SECRET_KEY=your-super-secret-key-change-me
PORT=8000
HOST=0.0.0.0
DEBUG=True
EMBEDDING_BATCH_SIZE=20
