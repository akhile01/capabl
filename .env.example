# Environment variables for AdaptEd project

CLEAN_API_KEY=your_clean_api_key_here
CLEAN_BASE_URL=https://cleanapis.com/v1
CLEAN_MODEL=claude-sonnet-5
LLM_PROVIDER=clean

# ---- Gateway Compatibility (Nova API / OpenAI gateway) -------------------
NOVA_API_KEY=your_clean_or_nova_api_key_here
NOVA_BASE_URL=https://cleanapis.com/v1
NOVA_MODEL=claude-sonnet-5
# NOVA_MODEL_PREFERENCES=claude-sonnet-5,claude-opus-5,gemini-3.7-flash

# ---- Google Gemini (Optional Alternative) --------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# ---- Server ---------------------------------------------------------------
DATABASE_URL=sqlite:///database.db
SECRET_KEY=your-super-secret-key-change-me
PORT=8000
HOST=0.0.0.0
DEBUG=True
EMBEDDING_BATCH_SIZE=20
