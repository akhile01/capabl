# Environment variables for AdaptEd project

# Database configuration
DATABASE_URL=sqlite:///database.db

# API Keys & Secrets
SECRET_KEY=your-super-secret-key-change-me
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Amazon Nova API / Nova Act
NOVA_API_KEY=your_nova_api_key_here
AMAZON_NOVA_API_KEY=your_nova_api_key_here
NOVA_BASE_URL=https://api.nova.amazon.com/v1
# Model choice: nova-pro-v1 (best reasoning), nova-lite-v1 (fast & lightweight), or nova-micro-v1 (fastest)
NOVA_MODEL=nova-pro-v1

# AWS Bedrock Configuration (if accessing Amazon Nova via AWS Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Deepgram Nova Configuration (if using Deepgram Nova Speech-to-Text API)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Server configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
EMBEDDING_BATCH_SIZE=20
